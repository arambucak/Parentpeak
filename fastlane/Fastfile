default_platform(:ios)

platform :ios do

  # ── Zertifikate & Profile via match ──────────────────────────────────────
  desc "Sync App Store signing certificates and provisioning profiles"
  lane :certificates do
    match(
      type: "appstore",
      app_identifier: "com.parentpeak.app",
      readonly: false,
      git_url: "https://github.com/arambucak/Parentpeak-certificates.git"
    )
  end

  # ── TestFlight Build & Upload ─────────────────────────────────────────────
  desc "Build and upload to TestFlight"
  lane :beta do
    # 1. Sync certificates
    match(
      type: "appstore",
      app_identifier: "com.parentpeak.app",
      readonly: true,
      git_url: "https://github.com/arambucak/Parentpeak-certificates.git"
    )

    # 2. Build Flutter IPA
    sh("cd .. && flutter build ipa --release --export-options-plist ios/ExportOptions.plist")

    # 3. Upload to TestFlight
    upload_to_testflight(
      ipa: "../build/ios/ipa/Parentpeak.ipa",
      changelog: File.read("./metadata/ios/en-US/release_notes.txt").strip,
      skip_waiting_for_build_processing: true
    )

    puts "✅ Uploaded to TestFlight!"
  end

  # ── App Store Release ─────────────────────────────────────────────────────
  desc "Submit to App Store"
  lane :release do
    match(
      type: "appstore",
      app_identifier: "com.parentpeak.app",
      readonly: true
    )

    sh("cd .. && flutter build ipa --release --export-options-plist ios/ExportOptions.plist")

    deliver(
      ipa: "../build/ios/ipa/Parentpeak.ipa",
      metadata_path: "./metadata/ios",
      force: true,
      submit_for_review: false,
      automatic_release: false
    )
  end

end

platform :android do

  # ── Google Play Beta Upload ───────────────────────────────────────────────
  desc "Upload AAB to Google Play internal testing"
  lane :beta do
    # Release-Build mit den nötigen dart-defines, aber OHNE den (seit #241
    # serverseitig wertlosen) BACKEND_API_TOKEN und ohne Gemini-API-Key.
    # Backend-URL fest auf die offizielle Domain. Übrige nicht-geheime Werte
    # aus der lokalen .env (Stripe-Key, Gemini-Modellname); fehlende URLs/
    # Kontaktangaben fallen auf die Defaults in APIConfig zurück.
    env = {}
    env_path = File.expand_path("../.env", __dir__)
    if File.exist?(env_path)
      File.foreach(env_path) do |line|
        line = line.strip
        next if line.empty? || line.start_with?("#") || !line.include?("=")
        k, v = line.split("=", 2)
        env[k.strip] = v.strip.gsub(/\A["']|["']\z/, "")
      end
    end

    defines = []
    defines << "--dart-define=BACKEND_BASE_URL=https://api.parentpeak.com"
    %w[STRIPE_PUBLISHABLE_KEY GEMINI_MODEL_NAME PRIVACY_POLICY_URL
       TERMS_OF_SERVICE_URL CONTACT_EMAIL CONTACT_SUPPORT_URL].each do |key|
      value = env[key]
      defines << "--dart-define=#{key}=#{value}" if value && !value.empty?
    end

    sh("cd .. && flutter build appbundle --release #{defines.join(' ')}")

    upload_to_play_store(
      track: "internal",
      aab: File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__),
      json_key: File.expand_path("~/ParentPeak-Keys/play-service-account.json"),
      metadata_path: "./metadata/android",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    puts "✅ Uploaded to Google Play Internal Testing!"
  end

  # ── Google Play Production ────────────────────────────────────────────────
  desc "Promote to Google Play production"
  lane :release do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key: File.expand_path("~/ParentPeak-Keys/play-service-account.json"),
      metadata_path: "./metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    puts "✅ Promoted to Google Play Production!"
  end

end
