{
  "name": "parentpeak-backend",
  "version": "1.0.0",
  "description": "Parentpeak Marktplatz Backend für Nachhilfe & Nannys",
  "main": "server.js",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "preinstall": "node node_runtime.cjs",
    "postinstall": "prisma generate",
    "premigrate:deploy": "node node_runtime.cjs",
    "migrate:deploy": "prisma migrate deploy",
    "prestart": "node node_runtime.cjs",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "test:integration": "node --test tests/integration/invite-dryrun.integration.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "10.0.16",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "resend": "^6.18.1",
    "stripe": "^22.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "fast-uri": "3.1.8",
    "fast-xml-parser": "5.10.1"
  }
}
