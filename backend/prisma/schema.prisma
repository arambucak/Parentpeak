// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// AUTHENTICATION & USERS
// ============================================================================

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  passwordHash          String
  passwordSalt          String
  firstName             String?
  lastName              String?
  avatar                String?
  bio                   String?
  
  // Trial/Premium Entitlements
  createdAt             DateTime @default(now())
  trialExpiresAt        DateTime?
  isPremium             Boolean  @default(false)
  premiumExpiresAt      DateTime?
  
  // Relations - unique names for each relation
  createdFamilies       Family[]        @relation("FamilyCreator")
  familyMemberships     Family[]        @relation("FamilyMembers")
  eventParticipations   EventParticipation[]
  paymentTransactions   PaymentTransaction[]
  messages              Message[]
  chatReports           ChatReport[]
  treasureRatingsGiven  TreasureRating[]  @relation("TreasureRatingFrom")
  handoverRequests      TreasureHandover[]  @relation("TreasureHandoverRequester")
  
  @@index([email])
  @@index([createdAt])
}

// ============================================================================
// FAMILY & SOCIAL
// ============================================================================

model Family {
  id                    String   @id @default(cuid())
  name                  String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Creator of family
  createdById           String
  createdByUser         User     @relation("FamilyCreator", fields: [createdById], references: [id], onDelete: Cascade)
  
  // Members of family
  memberUsers           User[]   @relation("FamilyMembers")
  
  // Child relations
  events                Event[]
  todos                 Todo[]
  shoppingItems         ShoppingItem[]
  treasureItems         TreasureItem[]
  
  @@index([createdById])
}

model FamilyRequest {
  id                    String   @id @default(cuid())
  fromUserId            String
  toUserId              String
  status                String   @default("pending") // pending, accepted, declined
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([fromUserId])
  @@index([toUserId])
}

// ============================================================================
// EVENTS
// ============================================================================

model Event {
  id                    String   @id @default(cuid())
  title                 String
  description           String?
  
  // Host/Creator (can be any external user, not necessarily in User table)
  hosterId              String
  
  // Family context (optional)
  familyId              String?
  family                Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)
  
  // Timing & Location
  startDate             DateTime
  endDate               DateTime?
  location              String?
  latitude              Float?
  longitude             Float?
  
  // Event Status & Type
  status                String   @default("upcoming") // upcoming, ongoing, completed, cancelled
  eventType             String   @default("generic") // generic, birthday, meeting, outing, etc.
  visibility            String   @default("publicNearby") // publicNearby, familyCircle, privateOnly, inviteOnly
  shareRadiusKm         Float    @default(25)
  inviteCode            String?  @unique
  inviteCodeExpiresAt   DateTime?
  
  // Pricing (optional)
  costPerPerson         Decimal? @db.Decimal(10, 2)
  currency              String   @default("EUR")
  maxParticipants       Int?
  
  // Metadata
  imageUrl              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  participants          EventParticipation[]
  chat                  EventChat?
  paymentTransactions   PaymentTransaction[]
  
  @@index([hosterId])
  @@index([familyId])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
}

model EventParticipation {
  id                    String   @id @default(cuid())
  
  eventId               String
  event                 Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status                String   @default("invited") // invited, accepted, declined, attended
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@unique([eventId, userId])
  @@index([userId])
  @@index([status])
}

// ============================================================================
// EVENT CHAT & MESSAGING
// ============================================================================

model EventChat {
  id                    String   @id @default(cuid())
  
  eventId               String   @unique
  event                 Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  messages              Message[]
  reports               ChatReport[]
  
  @@index([eventId])
}

model Message {
  id                    String   @id @default(cuid())
  
  chatId                String
  chat                  EventChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  authorId              String
  author                User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  content               String
  attachmentUrl         String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  reports               ChatReport[]
  
  @@index([chatId])
  @@index([authorId])
  @@index([createdAt])
}

model ChatReport {
  id                    String   @id @default(cuid())
  
  messageId             String
  message               Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  reportedById          String
  reportedBy            User     @relation(fields: [reportedById], references: [id], onDelete: Cascade)
  
  chatId                String
  chat                  EventChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  reason                String   // spam, offensive, inappropriate, etc.
  details               String?
  status                String   @default("pending") // pending, reviewed, resolved, dismissed
  
  createdAt             DateTime @default(now())
  resolvedAt            DateTime?
  
  @@index([messageId])
  @@index([reportedById])
  @@index([status])
}

// ============================================================================
// TREASURE ITEMS (VERSCHENKMARKT)
// ============================================================================

model TreasureItem {
  id                    String   @id @default(cuid())
  
  // Creator/Owner (can be any external user, not necessarily in User table)
  userId                String
  
  // Family context (optional)
  familyId              String?
  family                Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)
  
  // Item Details
  title                 String
  description           String?
  category              String   // toy, book, clothing, furniture, other
  subcategory           String?
  condition             String   @default("good") // new, good, fair, worn
  
  // Location & Visibility
  location              String?
  latitude              Float?
  longitude             Float?
  visibility            String   @default("nearby") // nearby, familyCircle, privateOnly
  shareRadiusKm         Float    @default(10) // How far to show this
  
  // Pricing (free or for sale)
  isFree                Boolean  @default(true)
  price                 Decimal? @db.Decimal(10, 2)
  currency              String   @default("EUR")
  
  // Media
  photoUrl              String?
  photoUrls             String[] @default([]) // Multiple photos
  
  // Handover Details
  availableForPickup    Boolean  @default(true)
  pickupLocation        String?  // Where to get it
  pickupSlots           String[] @default([]) // JSON serialized times
  
  // Status & Lifecycle
  status                String   @default("available") // available, claimed, expired, archived
  createdAt             DateTime @default(now())
  expiresAt             DateTime? // Auto-archive after 30 days
  updatedAt             DateTime @updatedAt
  
  // Metadata
  views                 Int      @default(0)
  rating                Float    @default(0) // Average rating (0-5)
  ratingCount           Int      @default(0)
  
  // Relations
  ratings               TreasureRating[]
  handovers             TreasureHandover[]
  reports               TreasureReport[]
  
  @@index([userId])
  @@index([familyId])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
  @@index([category])
}

model TreasureRating {
  id                    String   @id @default(cuid())
  
  treasureId            String
  treasure              TreasureItem @relation(fields: [treasureId], references: [id], onDelete: Cascade)
  
  fromUserId            String
  fromUser              User     @relation("TreasureRatingFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  
  rating                Int      // 1-5 stars
  comment               String?
  createdAt             DateTime @default(now())
  
  @@unique([treasureId, fromUserId])
  @@index([treasureId])
  @@index([fromUserId])
}

model TreasureHandover {
  id                    String   @id @default(cuid())
  
  treasureId            String
  treasure              TreasureItem @relation(fields: [treasureId], references: [id], onDelete: Cascade)
  
  requesterId           String
  requester             User     @relation("TreasureHandoverRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  
  status                String   @default("pending") // pending, confirmed, completed, cancelled
  scheduledTime         DateTime?
  location              String?
  notes                 String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([treasureId])
  @@index([requesterId])
  @@index([status])
}

model TreasureReport {
  id                    String   @id @default(cuid())

  treasureId            String
  treasure              TreasureItem @relation(fields: [treasureId], references: [id], onDelete: Cascade)

  reporterUserId        String
  reason                String
  note                  String?
  status                String   @default("pending") // pending, resolved, dismissed
  moderatorId           String?
  moderatorNote         String?

  createdAt             DateTime @default(now())
  resolvedAt            DateTime?
  updatedAt             DateTime @updatedAt

  @@index([treasureId])
  @@index([reporterUserId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// PAYMENTS & TRANSACTIONS
// ============================================================================

model PaymentTransaction {
  id                    String   @id @default(cuid())
  
  eventId               String
  event                 Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Payment Details
  amount                Decimal  @db.Decimal(10, 2)
  currency              String   @default("EUR")
  stripePaymentIntentId String   @unique
  stripeChargId         String?
  
  // Idempotency
  idempotencyKey        String   @unique
  
  // Status
  status                String   @default("pending") // pending, succeeded, failed, refunded
  
  // Refund tracking
  refundedAmount        Decimal? @db.Decimal(10, 2)
  refundedAt            DateTime?
  refundReason          String?
  
  // Audit trail
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  verifiedAt            DateTime?
  verifiedByType        String?  // "webhook", "manual", "api"
  auditDetails          Json?
  
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([stripePaymentIntentId])
}

// ============================================================================
// MARKETPLACE & PROVIDERS
// ============================================================================

model Provider {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  contactEmail          String
  contactPhone          String?
  website               String?
  imageUrl              String?
  
  // Provider categorization
  category              String   // catering, decoration, entertainment, venue, etc.
  
  // Location
  city                  String?
  country               String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([category])
  @@index([city])
}

// ============================================================================
// FAMILY UTILITIES
// ============================================================================

model Todo {
  id                    String   @id @default(cuid())
  title                 String
  description           String?
  done                  Boolean  @default(false)
  
  familyId              String
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime @default(now())
  dueDate               DateTime?
  completedAt           DateTime?
  
  @@index([familyId])
  @@index([done])
}

model ShoppingItem {
  id                    String   @id @default(cuid())
  name                  String
  quantity              Int      @default(1)
  bought                Boolean  @default(false)
  
  familyId              String
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime @default(now())
  boughtAt              DateTime?
  
  @@index([familyId])
  @@index([bought])
}

// ============================================================================
// PARENT MATCHING
// ============================================================================

model ParentMatchingProfile {
  id                    String   @id @default(cuid())
  externalId            String?  @unique
  ownerUserId           String?
  name                  String
  age                   Int
  city                  String
  latitude              Float?
  longitude             Float?
  bio                   String?
  interests             String[]
  languages             String[]
  valuesFocus           String[]
  childAges             String[]
  familyForm            String
  verificationLevel     String   @default("basic")
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  actions               ParentMatchingAction[]

  @@index([city])
  @@index([ownerUserId])
  @@index([isActive])
  @@index([createdAt])
}

model ParentMatchingAction {
  id                    String   @id @default(cuid())
  familyId              String
  profileId             String
  action                String
  createdAt             DateTime @default(now())
  actorUserId           String?

  profile               ParentMatchingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([profileId])
  @@index([action])
  @@index([createdAt])
  @@index([actorUserId])
}

// ============================================================================
// MEAL PLANNER - Essensplaner für Familien
// ============================================================================

model MealPlan {
  id                    String   @id @default(cuid())
  familyId              String
  date                  DateTime @db.Date
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  meals                 Meal[]

  @@unique([familyId, date])
  @@index([familyId])
  @@index([date])
}

model Meal {
  id                    String   @id @default(cuid())
  mealPlanId            String
  title                 String
  type                  String   // breakfast, lunch, snack, dinner
  description           String?
  ingredients           String   @default("[]") // JSON array as string
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  mealPlan              MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
  @@index([type])
}

// ============================================================================
// SHARED RECIPES - Gemeinsam Satt (Modern & Secure)
// ============================================================================

model SharedRecipe {
  id                    String   @id @default(cuid())
  externalId            String?  @unique
  
  // Creator & Metadata
  creatorUserId         String?
  familyId              String?
  title                 String
  description           String?
  category              String   // breakfast, lunch, dinner, snack, dessert, etc.
  difficulty            String   @default("mittel") // leicht, mittel, schwer
  prepTimeMinutes       Int?
  servings              Int      @default(2)
  
  // Recipe Content
  ingredients           String   // JSON array: [{name, quantity, unit}]
  instructions          String   // JSON array: [step1, step2, ...]
  
  // Media & SEO
  imageUrl              String?
  tags                  String[] // JSON array
  
  // Community Features
  rating                Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount           Int      @default(0)
  isFavorited           Boolean  @default(false)
  favoritedByCount      Int      @default(0)
  viewCount             Int      @default(0)
  
  // Moderation
  isPublished           Boolean  @default(true)
  isFeatured            Boolean  @default(false)
  reportedCount         Int      @default(0)
  lastReportedAt        DateTime?
  
  // Audit
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  publishedAt           DateTime?
  
  // Relations
  ratings               RecipeRating[]
  favorites             RecipeFavorite[]
  reports               RecipeReport[]
  offerComments         FoodOfferComment[]
  offerReservations     FoodOfferReservation[]
  
  @@index([familyId])
  @@index([creatorUserId])
  @@index([category])
  @@index([difficulty])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([rating])
  @@index([createdAt])
}

model FoodOfferComment {
  id                    String   @id @default(cuid())

  recipeId              String
  recipe                SharedRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  userId                String
  text                  String
  createdAt             DateTime @default(now())

  @@index([recipeId])
  @@index([createdAt])
}

model FoodOfferReservation {
  id                    String   @id @default(cuid())

  recipeId              String
  recipe                SharedRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  userId                String
  portions              Int      @default(1)
  completedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
}

model RecipeRating {
  id                    String   @id @default(cuid())
  
  recipeId              String
  recipe                SharedRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  
  userId                String
  rating                Int      // 1-5 stars
  comment               String?
  
  createdAt             DateTime @default(now())
  
  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
  @@index([rating])
}

model RecipeFavorite {
  id                    String   @id @default(cuid())
  
  recipeId              String
  recipe                SharedRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  
  userId                String
  createdAt             DateTime @default(now())
  
  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
}

model RecipeReport {
  id                    String   @id @default(cuid())
  
  recipeId              String
  recipe                SharedRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  
  reportedById          String
  reason                String   // spam, offensive, incorrect, allergen_concern, etc.
  details               String?
  status                String   @default("pending") // pending, reviewed, resolved, dismissed
  
  createdAt             DateTime @default(now())
  resolvedAt            DateTime?
  
  @@index([recipeId])
  @@index([reportedById])
  @@index([status])
}


// ─── Community Events ────────────────────────────────────────────────────────

model CommunityEvent {
  id              String   @id @default(cuid())
  title           String
  description     String
  category        String   // theater, kino, sport, musik, natur, etc.
  ageGroups       String   // JSON array: ["baby","kita","grundschule"]
  venue           String   @default("beides") // indoor, outdoor, beides
  location        String
  city            String
  lat             Float?
  lon             Float?
  isPrivateAddress Boolean @default(false)
  eventDate       DateTime
  eventEndDate    DateTime?
  isRecurring     Boolean  @default(false)
  recurringNote   String?
  rainPlan        String?
  price           String   @default("kostenlos")
  isFree          Boolean  @default(true)
  url             String?
  imageUrl        String?
  organizer       String
  creatorType     String   @default("eltern") // eltern, verein, institution, unternehmen
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  accessibility   String   @default("[]") // JSON array
  eventLanguage   String   @default("de")
  source          String   @default("community") // community, partner, kiAgent
  isVerified      Boolean  @default(false)
  creatorId       String
  interestCount   Int      @default(0)
  flagCount       Int      @default(0)
  isHidden        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  flags           CommunityEventFlag[]
  interests       CommunityEventInterest[]

  @@index([city])
  @@index([creatorId])
  @@index([eventDate])
  @@index([category])
  @@index([isHidden])
}

model CommunityEventFlag {
  id        String   @id @default(cuid())
  eventId   String
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  reason    String   // spam, fake, unsafe, inappropriate
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
}

model CommunityEventInterest {
  id          String   @id @default(cuid())
  eventId     String
  event       CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  displayName String   @default("Elternteil")
  message     String?
  createdAt   DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}
