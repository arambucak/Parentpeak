# ============================================================================
# DATABASE CONFIGURATION (Required for Production)
# ============================================================================

# Get this URL from Render PostgreSQL database
# Format: postgresql://user:password@internal-host:5432/dbname
# See docs/POSTGRES_PRISMA_IMPLEMENTATION.md for setup instructions
DATABASE_URL="postgresql://user:password@host:5432/parentpeak_db"

# ============================================================================
# STRIPE CONFIGURATION
# ============================================================================

# STRIPE_SECRET_KEY (Required for Production Payments)
# 🔐 NEVER commit this to Git or share publicly!
# Get from Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Test Mode: starts with "sk_test_"
# Live Mode: starts with "sk_live_"
# Add to Render Dashboard ENVIRONMENT VARIABLES (not in Git)
STRIPE_SECRET_KEY="sk_test_YOUR_SECRET_KEY_HERE"

# Webhook Secret for payment event verification
# Get from Stripe Dashboard: Settings > Webhooks > Endpoint Details
# Used to verify that webhook events actually come from Stripe
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_ROTATED_SECRET"

# Time tolerance for Stripe webhook timestamp validation (in seconds)
STRIPE_WEBHOOK_TOLERANCE_SEC="300"

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# HTTP listen port; Render may supply its own value.
PORT=3000
# Production enables strict deployment defaults; use development only for local work.
NODE_ENV="production"

# Access lifecycle: keep enabled while Parentpeak is in free beta.
BETA_FREE_ACCESS="1"

# Set when ending beta (UTC ISO date, e.g. 2027-01-15T00:00:00Z).
# Existing beta users receive their 30-day trial from this date.
PUBLIC_LAUNCH_DATE=""

# ============================================================================
# CORS & SECURITY
# ============================================================================

# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS="https://parentpeak.onrender.com,https://parentpeak.de,http://localhost:3000"

# ============================================================================
# RATE LIMITING
# ============================================================================

# Write request rate limit window in milliseconds (default: 15 minutes)
WRITE_RATE_LIMIT_WINDOW_MS="900000"

# Maximum write requests per window per IP
WRITE_RATE_LIMIT_MAX="100"

# ============================================================================
# BACKEND AUTH
# ============================================================================

# Bearer token for write operations (set in Render for production)
BACKEND_API_TOKEN="your-secure-token-here"

# Server-side only; never expose this key to Flutter or web builds
GEMINI_API_KEY="your-gemini-api-key-here"

# Require verified Firebase ID tokens for client write operations
FIREBASE_REQUIRE_AUTH="1"

# Internal moderation and expert-verification admins
# Exact internal accounts can be listed here (comma-separated)
INTERNAL_MODERATOR_EMAILS="lead@parentpeak.de,ops@parentpeak.de"
# Trusted domains for moderation and expert verification review
INTERNAL_MODERATOR_DOMAINS="parentpeak.de,parentpeak.com"

# Optional override for weekly impulse schema file path
# Useful when deployment has a non-standard working directory
WEEKLY_IMPULSE_SCHEMA_PATH="/opt/render/project/src/backend/weekly_impulse_schema_year3.json"

# Whether to allow client-side provider event creation (disable in production)
ALLOW_CLIENT_PROVIDER_EVENTS="0"

# Self-service premium activation without payment proof (local testing only, never in production)
ALLOW_SELF_SERVICE_PREMIUM="0"

# ============================================================================
# VERIFIED IDENTITY & FAIL-CLOSED PERSISTENCE
# ============================================================================

# Comma-separated Firebase UIDs for administrative routes; empty grants no user admin access.
ADMIN_USER_IDS=""

# Require write authentication in every environment (production default is 1).
REQUIRE_AUTH_FOR_WRITES="1"

# Keep 1 to reject persistence failures instead of returning in-memory success.
DISABLE_IN_MEMORY_FALLBACKS="1"

# Inline service-account JSON, injected through deployment secrets; never commit the real JSON.
# Takes precedence over GOOGLE_APPLICATION_CREDENTIALS; leave empty when using a mounted file.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Alternative: absolute path to a securely mounted Google credentials file, not its contents.
# Set one credentials method; the file must not be stored in the repository.
GOOGLE_APPLICATION_CREDENTIALS=""

# Optional storage bucket name; defaults from the service account's project_id.
FIREBASE_STORAGE_BUCKET=""

# Verify database TLS certificates for the Render-matched SSL configuration (1 or true).
# Configure the appropriate trusted CA; do not disable verification to bypass certificate errors.
DATABASE_SSL_STRICT="1"

# Optional PEM CA certificate text (not a file path); alone does not enable strict TLS.
DATABASE_SSL_CA=""

# Demo bootstrap is nonproduction-only; keep disabled in shared/deployed environments.
ALLOW_DEMO_BOOTSTRAP="0"

# ============================================================================
# AI & OTP LIMITS
# ============================================================================

# AI rate-limit window in milliseconds; use a positive integer.
AI_RATE_LIMIT_WINDOW_MS="900000"

# Maximum AI requests per rate-limit key/window; use a positive integer.
AI_RATE_LIMIT_MAX="30"

# Global per-process UTC-day AI request cap; nonpositive/invalid values disable the cap.
AI_DAILY_BUDGET_MAX="2000"

# Required stable private OTP hashing key in deployment; generate securely, never use this example.
OTP_HASH_SECRET="REPLACE_WITH_SECURE_RANDOM_OTP_HASH_SECRET"

# Matching OTP validity in milliseconds; use a positive integer.
PARENT_MATCHING_OTP_TTL_MS="600000"

# Maximum verification attempts per matching OTP; use a positive integer.
PARENT_MATCHING_OTP_MAX_ATTEMPTS="5"

# Matching OTP request rate window in milliseconds; use a positive integer.
PARENT_MATCHING_OTP_RATE_WINDOW_MS="600000"

# Matching OTP requests allowed per rate window; use a positive integer.
PARENT_MATCHING_OTP_RATE_MAX="3"

# Never return OTP codes in responses; development-only echo stays disabled.
ALLOW_DEV_OTP_ECHO="0"

# ============================================================================
# EMAIL, PUBLIC URLS & RELEASE READINESS
# ============================================================================

# Trusted absolute handler URL used in Firebase email action links.
AUTH_ACTION_URL="https://parentpeak.onrender.com/auth/action"

# Optional private Resend API key, injected as a deployment secret; Resend takes precedence over SMTP.
RESEND_API_KEY=""

# Alternative SMTP server; transport is enabled only when host, user and password are all set.
SMTP_HOST=""

# SMTP account name; may also be used as the fallback From address.
SMTP_USER=""

# Private SMTP password injected through deployment secrets; never commit a real value.
SMTP_PASS=""

# SMTP TCP port (normally 587 for STARTTLS or 465 for implicit TLS).
SMTP_PORT="587"

# Only exact true enables implicit TLS (normally port 465); false uses the configured SMTP transport.
SMTP_SECURE="false"

# Display name for outgoing mail, used by SMTP and Resend.
SMTP_FROM_NAME="ParentPeak"

# Verified sending address for SMTP and Resend; replace with your provider-approved address.
SMTP_FROM_EMAIL="noreply@example.invalid"

# Public upload URL prefix; absent/empty produces relative /uploads/... URLs.
PUBLIC_BASE_URL="https://parentpeak.onrender.com"

# Render supplies the actual 40-character lowercase commit SHA; leave blank locally (readiness 503).
# Do not hardcode an example SHA that falsely claims deployment evidence.
RENDER_GIT_COMMIT=""
